#!/usr/bin/env zsh
# Run spotlessApply before pushing to keep code formatting consistent.
# This file lives in .githooks/ and is tracked by Git.
# Git is pointed at this directory via: git config core.hooksPath .githooks
# This is configured automatically when you run ./gradlew build.
echo "Running spotlessApply before push..."
./gradlew spotlessApply
if [ $? -ne 0 ]; then
  echo "spotlessApply failed. Push aborted."
  exit 1
fi

# Check if spotlessApply modified any files.
if ! git diff --quiet; then
  echo ""
  echo "spotlessApply reformatted files. Please stage and commit the changes before pushing:"
  echo ""
  git diff --name-only
  echo ""
  echo "  git add -u && git commit --amend --no-edit"
  echo ""
  exit 1
fi
