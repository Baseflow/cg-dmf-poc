headers {
  X-NLX-Request-Application-Id: bruno-client
}

auth {
  mode: none
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: http://localhost:8080
  authorization_url: {{oidc.authUrl}}
  access_token_url: {{oidc.tokenUrl}}
  refresh_token_url:
  client_id: {{oidc.clientId}}
  client_secret: {{oidc.clientSecret}}
  scope:
  state:
  pkce: true
  credentials_placement: body
  credentials_id: credentials
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

vars:pre-request {
  firstId: 7f762fa6-ae89-43c7-9690-d06e4b586c32
  lastId: ""
  createdId: ""
}

script:pre-request {
  const jwt = require("jsonwebtoken");

  const clientId = bru.getEnvVar("jwt.clientId");
  const clientSecret = bru.getEnvVar("jwt.clientSecret");

  // If neither is set, skip JWT generation entirely (e.g. using OAuth2 instead)
  if (!clientId && !clientSecret) {
    return;
  }

  // If only one is set, that's a misconfiguration — warn loudly
  if (!clientId || !clientSecret) {
    throw new Error("Both jwt.clientId and jwt.clientSecret must be set together.");
  }

  const payload = {
    iss: clientId,
    iat: Math.floor(Date.now() / 1000),
    client_id: clientId,
    user_id: "bruno-gzac@example.com",
    user_representation: "Bruno Client",
  };

  const token = jwt.sign(payload, clientSecret, { algorithm: "HS256" });
  bru.setVar("jwtToken", token);
  req.setHeader("Authorization", `Bearer ${token}`);
}

