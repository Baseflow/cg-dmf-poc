meta {
  name: Upload filepart (3)
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/documenten/api/v1/bestandsdelen/{{bestandsDeel3}}
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  inhoud: @file(../data/Choorstraat 2-20 - Kelders - Choorstraat met riolering (003).pdf-ac)
  lock: {{lockId}}
}

settings {
  encodeUrl: true
  timeout: 0
}
