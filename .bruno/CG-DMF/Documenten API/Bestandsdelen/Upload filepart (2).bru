meta {
  name: Upload filepart (2)
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/documenten/api/v1/bestandsdelen/{{bestandsDeel2}}
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  inhoud: @file(../data/Choorstraat 2-20 - Kelders - Choorstraat met riolering (003).pdf-ab)
  lock: {{lockId}}
}

settings {
  encodeUrl: true
  timeout: 0
}
