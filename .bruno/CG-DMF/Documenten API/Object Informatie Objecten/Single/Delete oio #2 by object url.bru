meta {
  name: Delete oio #2 by object url
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/documenten/api/v1/objectinformatieobjecten?object={{objectUrl}}
  body: none
  auth: inherit
}

params:query {
  object: {{objectUrl}}
}

assert {
  res.status: eq 204
}

settings {
  encodeUrl: true
  timeout: 0
}
