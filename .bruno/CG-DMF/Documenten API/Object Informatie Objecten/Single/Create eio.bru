meta {
  name: Create eio
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten
  body: json
  auth: inherit
}

body:json {
  {
    "bronorganisatie": "623058911",
    "identificatie": "stringd",
    "titel": "mijn titel",
    "taal": "dut",
    "bestandsnaam": "{{file_name}}",
    "auteur": "DJ",
    "creatiedatum": "2025-12-10",
    "formaat": "application/pdf",
    "inhoud": "{{file_base64}}",
    "integriteit": {
      "algoritme": "sha_256",
      "waarde": "{{file_sha256}}",
      "datum": "{{local_date}}"
    },
    "beschrijving": "Test document uploaded by Bruno",
    "informatieobjecttype": "{{catalogusBaseUrl}}/informatieobjecttypen/1c8beee4-5b1b-4c7b-934c-925a3babd29d",
    "status": "vastgesteld"
  }
}

vars:pre-request {
  file_base64: VGVzdGZpbGUgd2l0aCBqdXN0IHNvbWUgc2ltcGxlIGRhdGEKV2UgYmUgdGVzdGluZwo=
  file_sha256: 29331452e10453e92b66362e359a0a8d5dbee081ab366541e3f870a3fe3f8ecd
  file_name: dj_test1
  local_date: 2025-12-16
}

vars:post-response {
  createdId: res.body.id
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
