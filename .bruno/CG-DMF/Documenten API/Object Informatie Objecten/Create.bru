meta {
  name: Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/documenten/api/v1/objectinformatieobjecten
  body: json
  auth: inherit
}

body:json {
  {
    "informatieobject": "{{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten/{{eio_id}}",
    "object": "{{zakenBaseUrl}}/zaken/{{zaak_id}}",
    "objectType": "zaak"
  }
}

vars:pre-request {
  zaak_id: 87654321-4321-4321-4321-210987654321
}

script:pre-request {
  // Generate a random UUID for zaak_id to avoid duplicate conflicts
  const generateUUID = () => {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
      const r = Math.random() * 16 | 0;
      const v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  };

  bru.setVar("zaak_id", generateUUID());

  // Fetch the first EIO to use in the request
  const response = await bru.runRequest(
    "Documenten API/Enkelvoudig Informatie Object/Get All"
  );

  if (!response) {
    throw new Error("Get All request returned no response");
  }

  const data = response.data;
  if (!data.results || !Array.isArray(data.results) || data.results.length === 0) {
    throw new Error("No results returned from Get All");
  }

  const firstId = data.results[0].id;
  bru.setVar("eio_id", firstId);
}

settings {
  encodeUrl: true
  timeout: 0
}

