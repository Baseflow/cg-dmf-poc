meta {
  name: Get All paginated
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/documenten/api/v1/objectinformatieobjecten?page=1&pageSize=1
  body: none
  auth: inherit
}

params:query {
  page: 1
  pageSize: 1
}

assert {
  res.status: eq 200
  res.body.results.length: eq 1
  res.body.results[0].informatieobject: endsWith {{createdId}}
}

settings {
  encodeUrl: true
  timeout: 0
}
