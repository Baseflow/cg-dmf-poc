meta {
  name: Create (versie 1)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten
  body: json
  auth: inherit
}

body:json {
  {
    "bronorganisatie": "623058911",
    "identificatie": "versie-test-{{$timestamp}}",
    "titel": "Versie test document v1",
    "taal": "dut",
    "bestandsnaam": "versie-test-v1.txt",
    "auteur": "Bruno",
    "creatiedatum": "2026-01-01",
    "formaat": "text/plain",
    "inhoud": "dmVyc2llIDF2ZXJzaWUgMXZlcnNpZSAx",
    "bestandsomvang": 24,
    "beschrijving": "Versie 1",
    "informatieobjecttype": "{{catalogusBaseUrl}}/informatieobjecttypen/1c8beee4-5b1b-4c7b-934c-925a3babd29d",
    "status": "in_bewerking",
    "inhoudIsVervallen": false
  }
}

assert {
  res.status: eq 201
  res.body.versie: eq 1
  res.body.taal: eq dut
  res.body.bestandsnaam: eq versie-test-v1.txt
}

script:post-response {
  bru.setVar("versieTestId", res.body.id);
}

settings {
  encodeUrl: true
  timeout: 0
}
