meta {
  name: Get zonder versie param geeft laatste versie
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten/{{versieTestId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.versie: eq 2
  res.body.taal: eq eng
}

settings {
  encodeUrl: true
  timeout: 0
}
