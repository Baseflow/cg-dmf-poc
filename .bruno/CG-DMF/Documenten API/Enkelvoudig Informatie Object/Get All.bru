meta {
  name: Get All
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten
  body: none
  auth: inherit
}

query {
  ~identificatie: DOC-001
  ~bronorganisatie: 012345678
  ~page: 1
  ~pageSize: 100
  ~trefwoorden: trefwoord1,trefwoord2
  ~objectinformatieobjecten__object: {{zakenBaseUrl}}/zaken/12345
  ~objectinformatieobjecten__objectType: zaak
}

settings {
  encodeUrl: true
  timeout: 0
}
