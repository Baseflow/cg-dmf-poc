meta {
  name: Get All
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten
  body: none
  auth: inherit
}

params:query {
  ~ordering: auteur,bestandsomvang,creatiedatum,formaat,status,titel,vertrouwelijkheidaanduiding
  ~vertrouwelijkheidaanduiding: openbaar
  ~titel: via patch
  ~locked: false
  ~informatieobjecttype: https://openzaak.dev.baseflow.com/catalogi/api/v1/informatieobjecttypen/1c8beee4-5b1b-4c7b-934c-925a3babd29d
  ~creatiedatum__gt: 2026-01-23
  ~creatiedatum__gte:
  ~creatiedatum__lt:
  ~creatiedatum__lte:
  ~registratiedatum__lt:
  ~registratiedatum__lte:
  ~registratiedatum__gt:
  ~registratiedatum__gte: 2026-03-18T15:30:52.930599
  ~beschrijving: Bruno
  ~auteur: dj
  ~identificatie: DOC-001
  ~bronorganisatie: 012345678
  ~page: 1
  ~pageSize: 100
  ~trefwoorden: trefwoord1,trefwoord2
  ~objectinformatieobjecten__object: {{zakenBaseUrl}}/zaken/fe1a198a-885e-4782-af0f-e6d521fb9e58
  ~objectinformatieobjecten__objectType: zaak
}

script:post-response {
  const results = res.body.results
  const createdId = results[results.length-1].id;
  bru.setVar("createdId", createdId);
}

settings {
  encodeUrl: true
  timeout: 0
}
