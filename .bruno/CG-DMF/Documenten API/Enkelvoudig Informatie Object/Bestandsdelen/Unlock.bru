meta {
  name: Unlock
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten/{{bestandsDelenEioID}}/unlock
  body: json
  auth: inherit
}

body:json {
  {
    "lock": "{{lockId}}"
  }
}

assert {
  res.status: eq 204
}

settings {
  encodeUrl: true
  timeout: 0
}
