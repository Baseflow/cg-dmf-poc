meta {
  name: Upload filepart (4)
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/documenten/api/v1/bestandsdelen/{{bestandsDeel4}}
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  inhoud: @file(../data/Choorstraat 2-20 - Kelders - Choorstraat met riolering (003).pdf-ad)
  lock: {{lockId}}
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
