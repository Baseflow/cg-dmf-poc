meta {
  name: Search
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten/_zoek
  body: json
  auth: inherit
}

params:query {
  ~page: 1
  ~pageSize: 100
  ~objectinformatieobjecten__object: {{zakenBaseUrl}}/zaken/12345
}

body:json {
  {
    "uuid_In": [
      "{{createdId}}"
    ],
    "expand": "informatieobjecttype"
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
