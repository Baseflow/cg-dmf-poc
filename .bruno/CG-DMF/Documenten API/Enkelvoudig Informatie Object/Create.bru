meta {
  name: Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten
  body: json
  auth: inherit
}

body:json {
  {
    "bronorganisatie": "012345678",
    "titel": "mijn titel",
    "taal": "dut",
    "bestandsnaam": "123",
    "inhoud": "{{file_base64}}",
    "auteur": "DJ",
    "creatiedatum": "2025-12-10"
  }
}

vars:pre-request {
  file_base64: 
  file_sha256: 
  file_size: 
  file_name: 
  local_time: 
}

script:pre-request {
  const fs = require("fs");
  const path = require("path");
  const CryptoJS = require("crypto-js");
  
  const fileName = "Choorstraat 2-20 - Kelders - Choorstraat met riolering (003).pdf";
  const filePath = path.resolve(process.cwd(), ".bruno/data", fileName);
  
  let fileBuffer;
  
  try {
    fileBuffer = fs.readFileSync(filePath);
  } catch (err) {
    console.error("Failed to read file:", filePath, err.message);
  
    bru.setEnvVar("file_error", `Failed to read file: ${err.message}`);
  
    // Optional: abort request if the file is required
    if (typeof onFail === "function") {
      onFail("Pre-request failed: cannot read file: " + filePath);
    }
  }
  
  // Only proceed if file read succeeded
  if (fileBuffer) {
    // -----------------------------------------------------------------
    // Base64
    // -----------------------------------------------------------------
    const base64Content = fileBuffer.toString("base64");
  
    // -----------------------------------------------------------------
    // SHA-256 using crypto-js
    // -----------------------------------------------------------------
    const wordArray = CryptoJS.lib.WordArray.create(fileBuffer);
    const sha256 = CryptoJS.SHA256(wordArray).toString(CryptoJS.enc.Hex);
  
    // -----------------------------------------------------------------
    // File size
    // -----------------------------------------------------------------
    const fileSize = fileBuffer.length;
  
    // -----------------------------------------------------------------
    // Local timestamp (ISO without trailing 'Z')
    // -----------------------------------------------------------------
    const now = new Date().toISOString();
  
    // -----------------------------------------------------------------
    // Store env vars
    // -----------------------------------------------------------------
    bru.setEnvVar("file_base64", base64Content);
    bru.setEnvVar("file_sha256", sha256);
    bru.setEnvVar("file_size", fileSize);
    bru.setEnvVar("file_name", fileName);
    bru.setEnvVar("local_time", now);
  
    console.log("File encoded and metadata prepared.");
    console.log(sha256);
    console.log(fileSize);
    console.log(fileName);
    console.log(now);
    console.log(base64Content);
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
