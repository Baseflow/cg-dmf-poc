meta {
  name: Set default repository
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/admin/storage-repositories/default
  body: json
  auth: inherit
}

body:json {
  {
    "name": "test-repo-bruno-updated"
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("response has isDefault true", function() {
    expect(res.body.isDefault).to.equal(true);
  });
  
  test("response name matches requested name", function() {
    expect(res.body.name).to.equal("test-repo-bruno-updated");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
