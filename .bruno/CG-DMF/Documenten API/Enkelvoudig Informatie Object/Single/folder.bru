meta {
  name: Single
}

auth {
  mode: inherit
}

script:pre-request {
  const response = await bru.runRequest(
    "Documenten API/Enkelvoudig Informatie Object/Get All"
  );
  
  if (!response) {
    throw new Error("Get All request returned no response");
  }
  
  const data = response.data;
  if (!data.results || !Array.isArray(data.results) || data.results.length === 0) {
    throw new Error("No results returned from Get All");
  }
  
  const firstId = data.results[0].id;
  const lastId = data.results[data.results.length - 1].id;
  bru.setVar("firstId", firstId);
  bru.setVar("lastId", lastId);
  
}
