meta {
  name: Get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten/{{createdId}}
  body: none
  auth: inherit
}

params:query {
  ~expand: informatieobjecttype
}

vars:post-response {
  lockId: res.body.lock
}

assert {
  res.status: eq 200
  res.body.inhoudIsVervallen: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
