meta {
  name: Get audittrails
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten/{{createdId}}/audittrail
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.length: eq 3
}

script:post-response {
  const firstAudit = res.body[0].uuid;
  bru.setVar("firstAudit", firstAudit);
}

settings {
  encodeUrl: true
  timeout: 0
}
