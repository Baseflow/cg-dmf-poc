meta {
  name: Create document in primary repository
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten
  body: json
  auth: inherit
}

body:json {
  {
    "bronorganisatie": "623058911",
    "identificatie": "multi-repo-primary",
    "titel": "multi repo primary",
    "taal": "dut",
    "bestandsnaam": "primary.txt",
    "auteur": "Bruno",
    "creatiedatum": "2025-12-10",
    "formaat": "text/plain",
    "inhoud": "cmVwby1hLWNvbnRlbnQ=",
    "bestandsomvang": 14,
    "integriteit": {
      "algoritme": "sha_256",
      "waarde": "48600744f29eea96018b440e2f6f580c4d0f6a10fbebe0f66934ff8fbe75faa5",
      "datum": "{{local_date}}"
    },
    "beschrijving": "Multi repository test document in primary repo",
    "informatieobjecttype": "{{catalogusBaseUrl}}/informatieobjecttypen/1c8beee4-5b1b-4c7b-934c-925a3babd29d",
    "status": "vastgesteld"
  }
}

vars:pre-request {
  local_date:
}

script:pre-request {
  const today = new Date().toISOString().split('T')[0];
  bru.setVar("local_date", today);
}

script:post-response {
  bru.setVar("multiRepoPrimaryId", res.body.id);
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
