meta {
  name: Set default repository to secondary
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/admin/storage-repositories/default
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{storage.secondaryRepo}}"
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
