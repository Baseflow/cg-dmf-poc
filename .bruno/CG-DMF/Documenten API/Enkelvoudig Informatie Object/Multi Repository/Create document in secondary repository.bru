meta {
  name: Create document in secondary repository
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten
  body: json
  auth: inherit
}

body:json {
  {
    "bronorganisatie": "623058911",
    "identificatie": "multi-repo-secondary",
    "titel": "multi repo secondary",
    "taal": "dut",
    "bestandsnaam": "secondary.txt",
    "auteur": "Bruno",
    "creatiedatum": "2025-12-10",
    "formaat": "text/plain",
    "inhoud": "cmVwby1iLWNvbnRlbnQ=",
    "bestandsomvang": 14,
    "integriteit": {
      "algoritme": "sha_256",
      "waarde": "39cbc78cbae460c75c1ebd0633c4a05b960167c47b0d07e15c60d6506d868f03",
      "datum": "{{local_date}}"
    },
    "beschrijving": "Multi repository test document in secondary repo",
    "informatieobjecttype": "{{catalogusBaseUrl}}/informatieobjecttypen/1c8beee4-5b1b-4c7b-934c-925a3babd29d",
    "status": "vastgesteld"
  }
}

vars:pre-request {
  local_date:
}

script:pre-request {
  const today = new Date().toISOString().split('T')[0];
  bru.setVar("local_date", today);
}

script:post-response {
  bru.setVar("multiRepoSecondaryId", res.body.id);
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
