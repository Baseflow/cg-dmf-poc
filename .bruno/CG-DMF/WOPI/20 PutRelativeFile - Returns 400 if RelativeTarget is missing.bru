meta {
  name: 20 PutRelativeFile - Returns 400 if RelativeTarget is missing
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/wopi/api/v1/files/{{wopiEioId}}?access_token={{wopiAccessToken}}
  body: text
  auth: none
}

params:query {
  access_token: {{wopiAccessToken}}
}

headers {
  X-WOPI-Override: PUT_RELATIVE
  Content-Type: application/octet-stream
  X-WOPI-Size: {{file_size}}
  ~X-WOPI-RelativeTarget: wopi-copy.docx
  ~X-WOPI-Overwrite-Relative-Target: false
}

body:text {
  {{file_content}}
}

assert {
  res.status: eq 400
}

script:pre-request {
  const content = "This should conflict"
  bru.setVar("file_content", content)
  bru.setVar("file_size", content.length)
}

settings {
  encodeUrl: true
  timeout: 0
}
