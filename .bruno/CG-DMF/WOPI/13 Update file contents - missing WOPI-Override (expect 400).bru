meta {
  name: 13 Update file contents - missing WOPI-Override (expect 400)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/wopi/api/v1/files/{{wopiEioId}}/contents?access_token={{wopiAccessToken}}
  body: text
  auth: none
}

params:query {
  access_token: {{wopiAccessToken}}
}

body:text {
  Some content
}

assert {
  res.status: eq 501
}

settings {
  encodeUrl: true
  timeout: 0
}
