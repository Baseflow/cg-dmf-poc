meta {
  name: 18 PutRelativeFile - SuggestedTarget (new file)
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/wopi/api/v1/files/{{wopiEioId}}?access_token={{wopiAccessToken}}
  body: text
  auth: none
}

params:query {
  access_token: {{wopiAccessToken}}
}

headers {
  X-WOPI-Override: PUT_RELATIVE
  X-WOPI-SuggestedTarget: wopi-copy.docx
  Content-Type: application/octet-stream
  X-WOPI-Size: {{file_size}}
}

body:text {
  {{file_content}}
}

vars:pre-request {
  file_content: 
}

vars:post-response {
  wopiRelativeFileId: res.body.Url
}

assert {
  res.status: eq 200
  res.body.Name: eq wopi-copy.docx
  res.body.Url: isDefined
}

script:pre-request {
  const content = "Hello WOPI PutRelativeFile"
  bru.setVar("file_content", content)
  bru.setVar("file_size", content.length)
}

script:post-response {
  // Extract UUID from the returned Url: .../files/<uuid>
  const url = res.body.Url;
  const uuid = url.split("/").pop();
  bru.setVar("wopiRelativeFileId", uuid);
  
}

settings {
  encodeUrl: true
  timeout: 0
}
