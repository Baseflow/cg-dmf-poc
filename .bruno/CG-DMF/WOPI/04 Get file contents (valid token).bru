meta {
  name: 04 Get file contents (valid token)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/wopi/api/v1/files/{{wopiEioId}}/contents?access_token={{wopiAccessToken}}
  body: none
  auth: bearer
}

params:query {
  access_token: {{wopiAccessToken}}
}

auth:bearer {
  token: d
}

vars:pre-request {
  wopiEioId: c4401ebb-a85e-455f-8ad3-28eba8f02e81
}

assert {
  res.status: eq 200
}

script:post-response {
  test("Response has a Content-Disposition header", function() {
    expect(res.headers["content-disposition"]).to.be.a("string");
  });
  
  test("Response body is non-empty", function() {
    expect(res.body).to.not.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
