meta {
  name: 01 Setup - Create EIO
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten
  body: json
  auth: inherit
}

body:json {
  {
    "bronorganisatie": "623058911",
    "identificatie": "wopi-slat-test-{{$timestamp}}",
    "titel": "WOPI SLAT test document",
    "taal": "dut",
    "bestandsnaam": "wopi-test.pdf",
    "auteur": "WOPI Test",
    "creatiedatum": "2026-05-07",
    "formaat": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "inhoud": "{{file_base64}}",
    "bestandsomvang": 26,
    "beschrijving": "Test document for WOPI SLAT end-to-end tests",
    "informatieobjecttype": "{{catalogusBaseUrl}}/informatieobjecttypen/1c8beee4-5b1b-4c7b-934c-925a3babd29d",
    "status": "vastgesteld",
    "integriteit": {
      "algoritme": "sha_256",
      "waarde": "{{file_sha256}}",
      "datum": "{{local_date}}"
    }
    
  }
}

vars:pre-request {
  file_base64: 
  file_sha256: 
  file_size: 
  local_date: 
}

vars:post-response {
  wopiEioId: res.body.id
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:pre-request {
  const fs = require("fs");
  const path = require("path");
  const CryptoJS = require("crypto-js");
  
  
  const content = "Hello WOPI SLAT test!"
  // -----------------------------------------------------------------
  // Base64
  // -----------------------------------------------------------------
  const base64Content = btoa(content);
  
  // -----------------------------------------------------------------
  
  // SHA-256 using crypto-js
  // -----------------------------------------------------------------
  
  const sha256 = CryptoJS.SHA256(content).toString(CryptoJS.enc.Hex);
  
  // -----------------------------------------------------------------
  // File size
  // -----------------------------------------------------------------
  const fileSize = content.length;
  
  // -----------------------------------------------------------------
  // Local timestamp (ISO without trailing 'Z')
  // -----------------------------------------------------------------
  const today = new Date().toISOString().split('T')[0];
  
  // -----------------------------------------------------------------
  // Store env vars
  // -----------------------------------------------------------------
  bru.setVar("file_base64", base64Content);
  bru.setVar("file_sha256", sha256);
  bru.setVar("file_size", fileSize);
  bru.setVar("local_date", today);
  
  
  
}

script:post-response {
  bru.setVar("wopiEioId", res.body.id);
}

settings {
  encodeUrl: true
  timeout: 0
}
