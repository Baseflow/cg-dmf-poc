meta {
  name: 02 Issue SLAT token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/wopi/api/v1/token/{{wopiEioId}}
  body: none
  auth: inherit
}

vars:post-response {
  wopiAccessToken: res.body.access_token
  wopiAccessTokenTtl: res.body.access_token_ttl
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
  res.body.access_token_ttl: isDefined
}

script:post-response {
  const token = res.body.access_token;
  const ttl = res.body.access_token_ttl;

  bru.setVar("wopiAccessToken", token);
  bru.setVar("wopiAccessTokenTtl", ttl);

  // Basic sanity checks on the token structure: <base64payload>.<base64sig>
  const parts = token.split(".");
  test("Token has two dot-separated parts (payload + signature)", function() {
    expect(parts.length).to.equal(2);
  });

  // TTL should be a future Unix epoch timestamp (more than "now")
  const nowEpoch = Math.floor(Date.now() / 1000);
  test("Token TTL is in the future", function() {
    expect(Number(ttl)).to.be.greaterThan(nowEpoch);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

