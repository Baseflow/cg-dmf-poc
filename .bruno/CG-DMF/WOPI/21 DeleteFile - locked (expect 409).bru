meta {
  name: 21 DeleteFile - locked (expect 409)
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/wopi/api/v1/files/{{wopiEioId}}?access_token={{wopiAccessToken}}
  body: none
  auth: none
}

params:query {
  access_token: {{wopiAccessToken}}
}

headers {
  X-WOPI-Override: DELETE
  X-WOPI-Lock: {{lockId}}
}

assert {
  res.status: eq 409
}

script:post-response {
  test("Response contains X-WOPI-Lock header with current lock value", function() {
    expect(res.headers["x-wopi-lock"]).to.equal(bru.getVar("lockId"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
