meta {
  name: 22 WOPI Unlock file (before DeleteFile)
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/wopi/api/v1/files/{{wopiEioId}}?access_token={{wopiAccessToken}}
  body: none
  auth: none
}

params:query {
  access_token: {{wopiAccessToken}}
}

headers {
  X-WOPI-Override: UNLOCK
  X-WOPI-Lock: {{lockId}}
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
