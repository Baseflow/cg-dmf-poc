meta {
  name: 20 PutRelativeFile - RelativeTarget collision without overwrite (expect 409)
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/wopi/api/v1/files/{{wopiEioId}}?access_token={{wopiAccessToken}}
  body: text
  auth: none
}

params:query {
  access_token: {{wopiAccessToken}}
}

headers {
  X-WOPI-Override: PUT_RELATIVE
  X-WOPI-RelativeTarget: wopi-copy.docx
  X-WOPI-Overwrite-Relative-Target: false
  Content-Type: application/octet-stream
}

body:text {
  This should conflict
}

assert {
  res.status: eq 409
  res.headers["x-wopi-validrelativetarget"]: isDefined
}

script:post-response {
  test("X-WOPI-ValidRelativeTarget header is a non-empty string", function() {
    const header = res.headers["x-wopi-validrelativetarget"];
    expect(header).to.be.a("string").with.length.greaterThan(0);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

