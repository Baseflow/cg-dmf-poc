meta {
  name: 13 Rename file (valid token, unlocked)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/wopi/api/v1/files/{{wopiEioId}}?access_token={{wopiAccessToken}}
  body: none
  auth: none
}

params:query {
  access_token: {{wopiAccessToken}}
}

headers {
  X-WOPI-Override: RENAME_FILE
  X-WOPI-RequestedName: renamed-document.docx
}

assert {
  res.status: eq 200
  res.body.Name: eq renamed-document.docx
}

settings {
  encodeUrl: true
  timeout: 0
}
