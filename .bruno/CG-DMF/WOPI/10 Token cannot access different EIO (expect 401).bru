meta {
  name: 10 Token cannot access different EIO (expect 401)
  type: http
  seq: 10
}

// Use the token issued for wopiEioId but request a different (hardcoded) UUID.
// The SLAT encodes the file_id it was issued for; the plugin cross-checks it
// against the URL path param, so using it on a different file_id must yield 401.
get {
  url: {{baseUrl}}/wopi/api/v1/files/00000000-dead-beef-0000-000000000001
  body: none
  auth: none
}

params:query {
  access_token: {{wopiAccessToken}}
}

assert {
  res.status: eq 401
}

script:post-response {
  test("Error detail mentions the token was not issued for this file", function() {
    const text = JSON.stringify(res.body).toLowerCase();
    expect(text).to.satisfy(
      (t) => t.includes("not issued") || t.includes("unauthorized") || t.includes("invalid")
    );
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

