meta {
  name: 98 Unlock file
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/documenten/api/v1/enkelvoudiginformatieobjecten/{{wopiEioId}}/unlock
  body: json
  auth: inherit
}

body:json {
  {
    "lock": "{{lockId}}"
  }
  
}

vars:post-response {
  lockId: res.body.lock
}

assert {
  res.status: in [204, 404]
}

settings {
  encodeUrl: true
  timeout: 0
}
