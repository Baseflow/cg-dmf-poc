meta {
  name: 15 Rename file - missing X-WOPI-RequestedName (expect 400)
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/wopi/api/v1/files/{{wopiEioId}}?access_token={{wopiAccessToken}}
  body: none
  auth: none
}

params:query {
  access_token: {{wopiAccessToken}}
}

headers {
  X-WOPI-Override: RENAME_FILE
}

assert {
  res.status: eq 400
}

settings {
  encodeUrl: true
  timeout: 0
}
