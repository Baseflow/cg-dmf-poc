meta {
  name: 07 Get contents - invalid token (expect 401)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/wopi/api/v1/files/{{wopiEioId}}/contents
  body: none
  auth: none
}

params:query {
  access_token: tampered.token.value
}

assert {
  res.status: eq 401
}

settings {
  encodeUrl: true
  timeout: 0
}

