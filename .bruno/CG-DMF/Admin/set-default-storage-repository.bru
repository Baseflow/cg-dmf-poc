meta {
  name: Set default repository
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/settings/storage-repositories/default
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{storage.defaultRepo}}"
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
