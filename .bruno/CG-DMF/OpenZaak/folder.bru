meta {
  name: OpenZaak
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{openzaak_jwt}}
}

vars:pre-request {
  openzaak_jwt: 
}

script:pre-request {
  const jwt = require("jsonwebtoken");
  
  const clientId = "cg-dmf";
  const secret = "baseflow";
  const now = 1767971383; // Math.floor(Date.now() / 1000);
  
  const payload = {
    client_id: clientId,
    iat: now
  };
  
  const token = jwt.sign(payload, secret, {
    algorithm: "HS256",
    issuer: clientId
  });
  
  console.log(token);
  bru.setVar("openzaak_jwt", token);
}
